CREATE TABLE Congregation (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    location TEXT NOT NULL,
    isActive INTEGER NOT NULL DEFAULT 1,
    createdAt INTEGER NOT NULL
);

CREATE INDEX idx_congregation_active ON Congregation(isActive);

selectAll:
SELECT * FROM Congregation ORDER BY name ASC;

selectActive:
SELECT * FROM Congregation WHERE isActive = 1 ORDER BY name ASC;

selectById:
SELECT * FROM Congregation WHERE id = ?;

insert:
INSERT INTO Congregation(name, location, isActive, createdAt)
VALUES (?, ?, ?, ?);

update:
UPDATE Congregation
SET name = ?, location = ?, isActive = ?
WHERE id = ?;

delete:
DELETE FROM Congregation WHERE id = ?;
